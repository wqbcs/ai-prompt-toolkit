{
  "comments": {
    "lineComment": "#",
    "blockComment": ["{#", "#}"]
  },
  "brackets": [
    ["{{", "}}"],
    ["{%", "%}"],
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{{", "close": "}}" },
    { "open": "{%", "close": "%}" },
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "`", "close": "`" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{{", "}}"],
    ["{%", "%}"],
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"]
  ],
  "wordPattern": "([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*)",
  "indentationRules": {
    "increaseIndentPattern": "{%-?\\s*(if|for|block|macro|compile|condition)\\b",
    "decreaseIndentPattern": "{%-?\\s*(endif|endfor|endblock|endmacro|endcompile|endcondition)\\b"
  },
  "folding": {
    "markers": {
      "start": "{%-?\\s*(if|for|block|macro|compile|condition)\\b",
      "end": "{%-?\\s*(endif|endfor|endblock|endmacro|endcompile|endcondition)\\b"
    }
  }
}
