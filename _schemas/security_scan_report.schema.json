{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SecurityScanReport",
  "type": "object",
  "required": ["timestamp", "template_id", "status", "details", "warnings"],
  "properties": {
    "timestamp": {"type": "string", "format": "date-time"},
    "template_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "status": {"type": "string", "enum": ["success", "partial", "failed", "blocked", "critical"]},
    "details": {
      "type": "object",
      "properties": {
        "injection_detections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule_id", "matched_pattern", "severity"],
            "properties": {
              "rule_id": {"type": "string"},
              "matched_pattern": {"type": "string"},
              "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
              "context": {"type": "string"},
              "remediation": {"type": "string"}
            }
          }
        },
        "inheritance_audits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["audit_type", "chain_path", "severity"],
            "properties": {
              "audit_type": {"type": "string", "enum": ["circular", "broken", "depth_exceeded", "risk_propagation"]},
              "chain_path": {"type": "array", "items": {"type": "string"}},
              "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
              "description": {"type": "string"}
            }
          }
        },
        "scan_time_ms": {"type": "number"},
        "rules_evaluated": {"type": "integer"},
        "whitelist_matches": {"type": "integer"}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
